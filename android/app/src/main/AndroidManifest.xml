<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      allowBackup=false: BirthdayBook is privacy-first. Data never leaves the
      device unless the user exports it (Excel / JSON / share sheet), so we opt
      out of Android Auto Backup to Google Drive.
    -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <!-- WebView loads bundled files only; required by Capacitor's local server. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 13+ runtime notification permission (requested from the Alarm Centre / onboarding). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Re-register scheduled reminders after the phone restarts (handled by the Local Notifications plugin). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Exact alarms (Android 12+). Declared but NOT requested by default:
      reminders are scheduled as inexact alarms unless the user turns on
      "Precise timing" in the Alarm Centre, which then opens the system
      "Alarms & reminders" setting. We deliberately do not use USE_EXACT_ALARM,
      which Google Play restricts to alarm-clock and calendar apps.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
</manifest>
